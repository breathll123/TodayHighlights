DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/daily_highlights
APP_SECRET_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
CORS_ORIGINS=http://localhost:5173
SCHEDULER_ENABLED=true
# EASTMONEY_PROXY=http://127.0.0.1:7890
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=today-highlights
REDIS_SOCKET_TIMEOUT_SECONDS=1
REDIS_LOCK_TTL_SECONDS=45
REDIS_RETRY_INTERVAL_SECONDS=30
ARTIFICIAL_ANALYSIS_API_KEY=
ARTIFICIAL_ANALYSIS_API_BASE=https://artificialanalysis.ai/api/v2
ARTIFICIAL_ANALYSIS_SYNC_ENABLED=false
ARTIFICIAL_ANALYSIS_QUOTA_RESERVE=2
ARTIFICIAL_ANALYSIS_MAX_RESPONSE_BYTES=10485760
ARTIFICIAL_ANALYSIS_REQUEST_TIMEOUT_SECONDS=30
ARTIFICIAL_ANALYSIS_SCHEDULE_MORNING=08:30
ARTIFICIAL_ANALYSIS_SCHEDULE_EVENING=20:30
ARTIFICIAL_ANALYSIS_STALE_HOURS=36
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=daily
LOG_RETENTION_DAYS=14
LOG_MAX_MESSAGE_LENGTH=4000
LOG_CONSOLE_ENABLED=true
LOG_SLOW_REQUEST_MS=2000
LOG_ACCESS_EXCLUDE_PATHS=/health
LOG_TRUST_PROXY_HEADERS=false
LOG_QUEUE_SIZE=10000
