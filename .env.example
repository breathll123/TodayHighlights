DATABASE_URL=mysql+pymysql://daily:daily@127.0.0.1:3306/daily_highlights
APP_SECRET_KEY=replace-with-output-from-python-fernet-generate-key
CORS_ORIGINS=http://localhost:5173
SCHEDULER_ENABLED=true

# Production file logging
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=daily
LOG_RETENTION_DAYS=14
LOG_MAX_MESSAGE_LENGTH=4000
LOG_CONSOLE_ENABLED=true
LOG_SLOW_REQUEST_MS=2000
LOG_ACCESS_EXCLUDE_PATHS=/health
LOG_TRUST_PROXY_HEADERS=false
LOG_QUEUE_SIZE=10000
LOG_DETAIL_CRAWLER=true
LOG_DETAIL_AI=true
LOG_RESPONSE_PREVIEW_CHARS=500
LOG_URL_QUERY_MODE=safe
